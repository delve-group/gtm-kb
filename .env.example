# Knowledge and HTTP
BRAIN_ROOT=brain
MCP_HOST=127.0.0.1
MCP_PORT=3000
PORT=3000
PUBLIC_BASE_URL=https://brain.example.com
TRUST_PROXY=1
MCP_ALLOWED_HOSTS=brain.example.com
REQUEST_TIMEOUT_MS=300000
HEADERS_TIMEOUT_MS=65000
KEEP_ALIVE_TIMEOUT_MS=75000

# Authentication and encrypted SQLite sessions
AUTH_MODE=hybrid
SECRET_KEY=
ALLOW_SECRET_WRITES=false
SESSION_SECRET=
SESSION_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=3600
SESSION_DB_PATH=/app/data/sessions.sqlite

# GitHub App (user-to-server OAuth + installation access)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# A literal multiline PEM or a single line containing escaped \\n sequences is supported.
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_REPOSITORY=owner/company-brain
GITHUB_DEFAULT_BRANCH=main
GITHUB_ALLOWED_ORGS=
GITHUB_ALLOWED_TEAMS=

# Langfuse
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=

# Set at image build time with --build-arg APP_GIT_SHA=<sha>.
APP_GIT_SHA=unknown
